data: {"annotation":{"doc_id":"tests/assert_verdicts_reconcile.sql","doc_title":"tests/assert_verdicts_reconcile.sql","index":778,"search_result_id":"cs_db7f49ac-84db-4b19-aab0-10796e3d2b00","text":"-- Fails if the verdict summary does not add up to the number of questions.\nselect (select sum(n_questions) from {{ ref('fct_verdict_summary') }}) as in_summary,\n       (select count(*) from {{ ref('stg_question_pack') }}) as in_pack\nwhere (select sum(n_questions) from {{ ref('fct_verdict_summary') }}) \u003c\u003e (select count(*) from {{ ref('stg_question_pack') }})\n","type":"cortex_search_citation"},"annotation_index":3,"content_index":5,"sequence_number":93}

